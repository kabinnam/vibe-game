# Normalize line endings; Git auto-detects text vs binary
* text=auto eol=lf

# Source files (LF)
*.cs   text eol=lf diff=csharp
*.gd   text eol=lf

# .NET project/solution files use CRLF by convention
*.sln     text eol=crlf -merge
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

# Godot text resources (LF; Godot owns their on-disk formatting)
*.tscn   text eol=lf
*.tres   text eol=lf
*.godot  text eol=lf
*.import text eol=lf
*.cfg    text eol=lf
*.uid    text eol=lf

# Binary assets - never normalize or attempt to diff
*.fbx   binary
*.glb   binary
*.gltf  binary
*.blend binary
*.obj   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.tga   binary
*.webp  binary
*.hdr   binary
*.exr   binary
*.ogg   binary
*.wav   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
